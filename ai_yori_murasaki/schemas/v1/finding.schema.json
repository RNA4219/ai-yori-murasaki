{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aym.local/schemas/v1/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "campaign_id", "run_id", "source", "severity", "title", "location", "references"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "finding_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "campaign_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source": {
      "type": "string",
      "enum": ["trivy", "codeql", "wazuh", "sigma", "rustxng", "rdsh", "llm", "benchmark_lab"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "column"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "column": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
