{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aym.local/schemas/v1/evidence_event.schema.json",
  "title": "EvidenceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "run_id", "sequence", "actor", "source", "event_type", "timestamp", "target", "finding", "evidence_refs", "previous_event_hash", "event_hash"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "campaign_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "source": {
      "type": "string",
      "enum": ["trivy", "codeql", "wazuh", "sigma", "rustxng", "rdsh", "llm", "oracle", "orchestrator", "broker"]
    },
    "event_type": {
      "type": "string",
      "enum": ["scope_validated", "fixture_reset", "red_plan", "attack_executed", "state_captured", "exploit_judged", "chain_sealed", "asset_inventory", "static_scan", "telemetry_ingested", "prioritized", "remediation_drafted", "detection_rule_drafted", "blind_completed", "purple_opened", "gap_analyzed", "sigma_drafted", "patch_drafted", "fp_fn_matrix", "playbook_created", "static_scan_result", "unit_result", "integration_result", "oracle_replay_result", "benign_regression_result", "red_reevaluated", "oracle_final_verdict", "approval_gate", "policy_denied", "adapter_unavailable", "rsi_frozen", "rsi_candidate_created", "rsi_compared", "rsi_ready", "rsi_applied"]
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/target"
    },
    "finding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["finding_id", "severity", "title"],
      "properties": {
        "finding_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "previous_event_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "event_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
