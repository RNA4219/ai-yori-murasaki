{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aym.local/schemas/v1/final_verdict.schema.json",
  "title": "FinalVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "run_id", "oracle_verdict", "oracle_reason_code", "run_completion", "adapter_status", "cancellation", "remediation_success", "benign_regression_passed", "remediation_id", "test_report_refs", "decided_at"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "campaign_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "oracle_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "HOLD"]
    },
    "oracle_reason_code": {
      "type": "string",
      "enum": ["exploit_succeeded", "exploit_not_succeeded", "execution_error", "evidence_missing", "evidence_mismatch", "not_executed", "adapter_unavailable", "cancelled"]
    },
    "run_completion": {
      "type": "string",
      "enum": ["completed", "incomplete", "cancelled", "adapter_unavailable"]
    },
    "adapter_status": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["trivy", "codeql", "wazuh", "sigma", "rustxng", "rdsh", "llm"]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable", "not_configured"]
          }
        }
      }
    },
    "cancellation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["cause", "at"],
      "properties": {
        "cause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "remediation_success": {
      "type": "boolean"
    },
    "benign_regression_passed": {
      "type": ["boolean", "null"]
    },
    "remediation_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "test_report_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
